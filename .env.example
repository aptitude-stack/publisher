# Local publisher configuration.
# Copy to .env for local runs; .env is ignored and should hold real secrets.

APTITUDE_REGISTRY_URL=http://127.0.0.1:8000
APTITUDE_PUBLISH_TOKEN=

# Garak is the authoritative security evaluator.
# Leave PUBLISHER_GARAK_ENABLED=true unless you intentionally want to skip it.
PUBLISHER_GARAK_ENABLED=true
GARAK_TARGET_TYPE=openai
GARAK_TARGET_NAME=gpt-4o-mini
GARAK_PROBES=promptinject
GARAK_GENERATIONS=1
GARAK_PARALLEL_ATTEMPTS=4
GARAK_CONFIDENCE_INTERVAL_METHOD=none
GARAK_SOFT_PROBE_PROMPT_CAP=8
PUBLISHER_GARAK_TIMEOUT_SECONDS=180
# PUBLISHER_GARAK_COMMAND=garak --target_type openai --target_name gpt-4o-mini --probes promptinject --report_prefix {artifact_dir}/garak

# Upskill is the authoritative performance evaluator.
# Leave PUBLISHER_UPSKILL_ENABLED=true unless you intentionally want no performance score.
PUBLISHER_UPSKILL_ENABLED=true
UPSKILL_MODELS=gpt-4o-mini
UPSKILL_PROVIDER=openai
UPSKILL_USE_DEFAULT_TESTS=true
UPSKILL_NO_BASELINE=false
PUBLISHER_UPSKILL_TIMEOUT_SECONDS=600
# UPSKILL_TESTS_PATH=/absolute/path/to/upskill-tests.json
# UPSKILL_BASE_URL=https://api.openai.com/v1
# PUBLISHER_UPSKILL_COMMAND=upskill eval {skill_path} -m gpt-4o-mini

# Provider tokens are intentionally blank in this example.
OPENAI_API_KEY=
