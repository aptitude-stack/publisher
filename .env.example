# Local publisher configuration.
# Copy to .env for local runs; .env is ignored and should hold real secrets.

APTITUDE_REGISTRY_URL=http://127.0.0.1:8000
APTITUDE_PUBLISH_TOKEN=
APTITUDE_ADMIN_TOKEN=

# LLM Guard is the authoritative security evaluator.
# Leave PUBLISHER_LLM_GUARD_ENABLED=true unless you intentionally want to skip it.
PUBLISHER_LLM_GUARD_ENABLED=true
PUBLISHER_LLM_GUARD_PROMPT_INJECTION_THRESHOLD=0.85
PUBLISHER_LLM_GUARD_MAX_TEXT_CHARS=120000

# Upskill is the authoritative performance evaluator.
# A publishable evaluation requires a scored OpenAI run and explicit test cases.
PUBLISHER_UPSKILL_ENABLED=true
UPSKILL_MODELS=gpt-4o-mini
UPSKILL_PROVIDER=openai
UPSKILL_NO_BASELINE=false
PUBLISHER_UPSKILL_TIMEOUT_SECONDS=600
# Required: JSON with a non-empty cases array whose each case has expected.contains.
UPSKILL_TESTS_PATH=/absolute/path/to/upskill-tests.json
# Set only for a custom OpenAI-compatible endpoint.
# UPSKILL_BASE_URL=https://example.invalid/v1

# Provider tokens are intentionally blank in this example.
OPENAI_API_KEY=

# Semantic LLM validation is independent from Upskill and opt-in only.
PUBLISHER_LLM_VALIDATION_ENABLED=false
